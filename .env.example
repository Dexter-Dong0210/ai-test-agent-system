# ============================================================
# 但问智能测试平台 - 环境变量配置模板
# ============================================================
# 说明：
#   1. 复制此文件为 .env
#   2. 填写实际的配置值（不要提交到版本控制）
#   3. 生产环境请勿提交真实密钥
# ============================================================

# ============================================================
# 1. 应用基础配置
# ============================================================
APP_NAME=但问智能测试平台
APP_VERSION=2.0.0
APP_PORT=8001
DEBUG=False
API_PREFIX=/api/v2

# ============================================================
# 2. 大语言模型 (LLM) 配置
# ============================================================
# DeepSeek 文本模型
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 图片解析模型（可选）
IMAGE_PARSER_API_BASE=https://ark.cn-beijing.volces.com/api/v3
IMAGE_PARSER_API_KEY=your-image-parser-api-key-here
IMAGE_PARSER_MODEL=doubao-seed-2-0-mini-260428

# ============================================================
# 3. LangSmith / LangChain 可观测性（可选）
# ============================================================
LANGSMITH_PROJECT=your-project-name
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=false

# ============================================================
# 4. 数据库配置
# ============================================================
# PostgreSQL（主数据库）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=ai_test_platform_db
POSTGRES_URI=postgresql://postgres:your-password@localhost:5432/ai_test_platform_db

# MongoDB（可选）
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=ai_test_management

# Redis
REDIS_URI=redis://localhost:6379/0

# ============================================================
# 5. 认证与安全
# ============================================================
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 开发环境默认测试用户
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_EMAIL=admin@test.com
DEFAULT_USER_NAME=管理员

# Auth 模块（LangGraph 开发模式）
AUTH_DEV_SECRET=change-this-dev-secret-in-production
AUTH_AUDIENCE=langgraph-dev

# ============================================================
# 6. MinIO 对象存储
# ============================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=test-management
MINIO_SECURE=false
MINIO_REGION=

# ============================================================
# 7. 附件与文档解析
# ============================================================
ATTACHMENT_MAX_SIZE=52428800
ENABLE_PDF_MULTIMODAL=false

# ============================================================
# 8. 速率限制与分页
# ============================================================
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=60
PAGINATION_DEFAULT_SIZE=30
PAGINATION_MAX_SIZE=300

# ============================================================
# 9. CORS 配置
# ============================================================
CORS_ORIGINS=["http://localhost:3000"]

# ============================================================
# 10. Agent 工作目录配置
# ============================================================
# API测试 Agent
API_WORKSPACE_ROOT=/path/to/workspace/api
API_SKILLS_ROOT=/path/to/skills

# Web MCP Agent
WEB_MCP_WORKSPACE_ROOT=/path/to/workspace/web_mcp
WEB_MCP_ROOT=/path/to/workspace/web_mcp
WEB_MCP_SKILLS_ROOT=/path/to/skills

# 测试用例生成 Agent
TESTCASE_WORKSPACE_ROOT=/path/to/workspace/testcase
TESTCASE_SKILLS_ROOT=/path/to/skills

# ============================================================
# 说明：
# - 所有标记为 "your-xxx-here" 的值需要在实际环境替换
# - 生产环境请使用强密码和安全的SECRET_KEY
# - 不要将此文件提交到版本控制系统
# ============================================================